{
  "name": "flipdown-timer-card",
  "version": "1.2.3",
  "description": "Flipdown timer card for lovelace",
  "main": "dist/flipdown-timer-card.js",
  "type": "module",
  "packageManager": "npm@11.21.0",
  "scripts": {
    "build": "npm run typecheck && npm run rollup",
    "rollup": "rollup -c",
    "typecheck": "tsc --noEmit",
    "babel": "babel dist/flipdown-timer-card.js --out-file dist/flipdown-timer-card.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "watch": "rollup -c --watch",
    "postversion": "npm run build",
    "audit-fix": "npm audit fix"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:Lint-Free-Technology/flipdown-timer-card.git"
  },
  "keywords": [
    "lovelace"
  ],
  "author": "pmongloid",
  "contributors": [
    "Darryn Capes-Davis (https://github.com/dcapslock)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Lint-Free-Technology/flipdown-timer-card/issues"
  },
  "homepage": "https://github.com/Lint-Free-Technology/flipdown-timer-card#readme",
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "baseline-browser-mapping": "^2.11.27",
    "prettier": "^3.8.3",
    "rollup": "^4.68.1",
    "rollup-plugin-serve": "^3.0.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@babel/core": "$@babel/core",
    "lodash": "^4.18.0"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
